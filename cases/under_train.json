{
    "version": "0.1.0",
    "env": {
        "tilelang": [
            "loss"
        ]
    },
    "model": {
        "arch": "QWEN3",
        "parameter": {
            "Layer": 1,
            "transformer": {
                "Ctx": 16,
                "Embed": 128,
                "Ffn": 512,
                "Head": 4,
                "KVHead": 4,
                "head_dim": 32
            },
            "max_pos_embeddings": 32768,
            "pad_mask": "last",
            "result_marker": "="
        },
        "backbone": {
            "embed_tokens": {
                "Embedding": []
            },
            "layer": {
                "self_attn": {
                    "QKV": []
                },
                "mlp": {
                    "FFN": []
                },
                "# gattn": {
                    "GAU": []
                }
            },
            "norm": {
                "Normal": []
            },
            "output": {
                "CLASIFY": []
            }
        }
    },
    "dict": {
        "type": "koifish_v0"
    },
    "train": {
        "dump-every": 20,
        "gpt-every": -10,
        "#epoch": 1,
        "most-iter": 3000,
        "batch": 8,
        "learning-rate": 0.001,
        "decay": 0.5,
        "optimizatioin": {
            "#method": "adamw sgdv hsgd sgd muon",
            "method": "adamw",
            "sign": 0,
            "grad_accumulation": 1,
            "lars_ratio": 0,
            "ZMUV_ratio": 0.00
        }
    },
    "datasets": {
        "train_eval": {
            "type": "synthetic",
            "most_samp": 100,
            "name": "math0",
            "split": 0.3,
            "eval-every": 100,
            "problem": 2
        }
    },
    "debug": {
        "eval_samp": 0.04,
        "preLogits_dB": -1,
        "liveplot": 1,
        "#long_tail": 10
    },
    "dump": {
        "train_time": 0,
        "# tensor_ref": 1,
        "most_mem_item": 6
    },
    "seed": 42
}